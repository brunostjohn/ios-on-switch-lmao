host_shims(
    name = "submit_kernel",
    headers = [
        "IOKit/IOBufferMemoryDescriptor.h",
        "IOKit/IOInterruptEventSource.h",
        "IOKit/IOLib.h",
        "IOKit/IOLocks.h",
        "IOKit/IOWorkLoop.h",
