load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

kernel_headers()

# The BM92T36 alternate-mode engine: SwitchPD (drivers/SwitchUSB) calls it after every ALERT.
kernel_driver(
    name = "SwitchPDAltMode",
    srcs = ["SwitchPDAltMode.cpp"],
    hdr_deps = [
        "drivers/SwitchUSB",
        "drivers/TegraI2C",
    ],
)

# DPAUX1, SOR1 and the native external framebuffer on display controller B.
kernel_driver(
    name = "SwitchDisplayPort",
    srcs = [
        "SwitchDisplayPort.cpp",
        "SwitchDPSession.cpp",
        "SwitchDPCEC.cpp",
        "SwitchDPProperties.cpp",
        "SwitchExternalScreen.cpp",
        "SwitchExternalScanout.cpp",
        "TegraDisplayB.cpp",
        "TegraDpaux1.cpp",
        "TegraSor1.cpp",
    ],
    abi = ["IOMobileFramebufferLegacy", "IOSurface"],
    hdr_deps = [
        "drivers/ArmGIC",
        "drivers/NativeMobileDisplay",
        "drivers/SwitchPower",
        "drivers/TegraGM20B",
        "drivers/TegraVIC",
        "kits/SwitchDMA",
        "drivers/TegraDisplayFlip",
        "drivers/TegraI2C",
        "drivers/TegraSMMU",
        "kits/SwitchCAR",
        "kits/SwitchMMIO",
    ],
    late = ["SwitchExternalScreen.cpp"],
)
