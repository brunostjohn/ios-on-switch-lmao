load("@rules_rust//rust:defs.bzl", "rust_test")

# drivers/NativeMetal on the host:
#   limits_table_test       LimitsTable.h: the device's answers in the base class's limits table, past a field the base
#                           class reads elsewhere (21H461's minConstantBufferAlignmentBytes)
#   queue_priority_test     QueuePriority.h: the process's GPU priority from its Metal queues' (Core Animation's)
#   image_filter_link_test  ImageFilterLink.h: Core Image's filter-function link request for the system's Metal compiler
#   metallib_entries_test   MetallibEntries.h: a metallib's function list, and which entries Metal answers as extern
#
#   bazel test //drivers/NativeMetal/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_test")

lint_files()

rust_test(
    name = "native_variants_test",
    srcs = ["//drivers/NativeMetal:bridge/NativeMetalVariants.rs"],
    edition = "2024",
)

host_test(
    name = "native_artifact_cache_test",
    srcs = [
        "native_artifact_cache_test.cpp",
        "//drivers/NativeMetal:NativeMetalArtifactCache.h",
    ],
    cxx_std = "c++17",
)

host_test(
    name = "limits_table_test",
    srcs = [
        "limits_table_test.cpp",
        "//drivers/NativeMetal:LimitsTable.h",
    ],
    cxx_std = "c++17",
    deps = ["//drivers/NativeMetal/abi:metal_abi"],
)

host_test(
    name = "queue_priority_test",
    srcs = [
        "queue_priority_test.cpp",
        "//drivers/NativeMetal:QueuePriority.h",
    ],
    cxx_std = "c++17",
)

host_test(
    name = "image_filter_link_test",
    srcs = [
        "image_filter_link_test.cpp",
        "//drivers/NativeMetal:ImageFilterLink.h",
    ],
    cxx_std = "c++17",
)

host_test(
    name = "metallib_entries_test",
    srcs = [
        "metallib_entries_test.cpp",
        "//drivers/NativeMetal:MetallibEntries.h",
    ],
    cxx_std = "c++17",
)

[host_test(
    name = name,
    srcs = [
        "async_pipelines_test.cpp",
        "//drivers/NativeMetal:AsyncPipelines.h",
    ],
    copts = [
        "-x",
        "objective-c++",
        "-fobjc-arc",
    ] + defines,
    cxx_std = "c++17",
    linkopts = [
        "-framework",
        "Foundation",
    ],
) for name, defines in [
    ("async_pipelines_test", []),
    ("async_pipelines_release_test", ["-DSWITCH_DEBUG=0"]),
]]

host_test(
    name = "switch_compile_reply_test",
    srcs = [
        "switch_compile_reply_test.cpp",
        "//drivers/NativeMetal:SwitchCompileReply.h",
    ],
    copts = [
        "-x",
        "objective-c++",
        "-fobjc-arc",
        "-Wno-deprecated-declarations",
    ],
    cxx_std = "c++17",
    linkopts = [
        "-framework",
        "Foundation",
    ],
)
