; SPIR-V
; Version: 1.3
; Bound: 80
               OpCapability Shader
               OpCapability Float16
       %glsl = OpExtInstImport "GLSL.std.450"
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %in_color %in_uv %out_half %out_unorm
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %in_color Location 0
               OpDecorate %in_uv Location 1
               OpDecorate %out_half Location 0
               OpDecorate %out_unorm Location 1
               OpDecorate %UboBlock Block
               OpMemberDecorate %UboBlock 0 Offset 0
               OpMemberDecorate %UboBlock 1 Offset 16
               OpDecorate %ubo DescriptorSet 0
               OpDecorate %ubo Binding 0
               OpDecorate %PushBlock Block
               OpMemberDecorate %PushBlock 0 Offset 0
               OpMemberDecorate %PushBlock 1 Offset 16
       %void = OpTypeVoid
       %fn_t = OpTypeFunction %void
        %f16 = OpTypeFloat 16
        %f32 = OpTypeFloat 32
      %v2f32 = OpTypeVector %f32 2
      %v4f32 = OpTypeVector %f32 4
      %v4f16 = OpTypeVector %f16 4
        %i32 = OpTypeInt 32 1
      %i32_0 = OpConstant %i32 0
      %i32_1 = OpConstant %i32 1
      %f32_0 = OpConstant %f32 0.0
      %f32_1 = OpConstant %f32 1.0
      %v4_0  = OpConstantComposite %v4f32 %f32_0 %f32_0 %f32_0 %f32_0
      %v4_1  = OpConstantComposite %v4f32 %f32_1 %f32_1 %f32_1 %f32_1
   %UboBlock = OpTypeStruct %v4f32 %v4f32
  %PushBlock = OpTypeStruct %v4f32 %v4f32
   %ptr_in_4 = OpTypePointer Input %v4f32
   %ptr_in_2 = OpTypePointer Input %v2f32
  %ptr_out_4 = OpTypePointer Output %v4f32
    %ptr_ubo = OpTypePointer Uniform %UboBlock
  %ptr_ubo_4 = OpTypePointer Uniform %v4f32
   %ptr_push = OpTypePointer PushConstant %PushBlock
 %ptr_push_4 = OpTypePointer PushConstant %v4f32
   %in_color = OpVariable %ptr_in_4 Input
      %in_uv = OpVariable %ptr_in_2 Input
   %out_half = OpVariable %ptr_out_4 Output
  %out_unorm = OpVariable %ptr_out_4 Output
        %ubo = OpVariable %ptr_ubo Uniform
       %push = OpVariable %ptr_push PushConstant
       %main = OpFunction %void None %fn_t
      %entry = OpLabel
          %c = OpLoad %v4f32 %in_color
         %uv = OpLoad %v2f32 %in_uv
      %p_u0  = OpAccessChain %ptr_ubo_4 %ubo %i32_0
         %u0 = OpLoad %v4f32 %p_u0
      %p_u1  = OpAccessChain %ptr_ubo_4 %ubo %i32_1
         %u1 = OpLoad %v4f32 %p_u1
      %p_p0  = OpAccessChain %ptr_push_4 %push %i32_0
         %p0 = OpLoad %v4f32 %p_p0
       %c_h  = OpFConvert %v4f16 %c
       %u0_h = OpFConvert %v4f16 %u0
       %p0_h = OpFConvert %v4f16 %p0
      %prod  = OpFMul %v4f16 %c_h %u0_h
       %sum  = OpFAdd %v4f16 %prod %p0_h
     %sum_32 = OpFConvert %v4f32 %sum
        %ux  = OpCompositeExtract %f32 %uv 0
        %uy  = OpCompositeExtract %f32 %uv 1
       %uv4  = OpCompositeConstruct %v4f32 %ux %uy %ux %uy
      %un_0  = OpExtInst %v4f32 %glsl Fma %sum_32 %u1 %uv4
      %un_c  = OpExtInst %v4f32 %glsl FClamp %un_0 %v4_0 %v4_1
               OpStore %out_half %sum_32
               OpStore %out_unorm %un_c
               OpReturn
               OpFunctionEnd
