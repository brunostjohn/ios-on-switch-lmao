; SPIR-V
; Version: 1.3
; Bound: 60
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %gl_Position %in_pos %in_uv %out_color %out_uv
               OpDecorate %gl_Position BuiltIn Position
               OpDecorate %in_pos Location 0
               OpDecorate %in_uv Location 1
               OpDecorate %out_color Location 0
               OpDecorate %out_uv Location 1
               OpDecorate %UboBlock Block
               OpMemberDecorate %UboBlock 0 ColMajor
               OpMemberDecorate %UboBlock 0 Offset 0
               OpMemberDecorate %UboBlock 0 MatrixStride 16
               OpMemberDecorate %UboBlock 1 Offset 64
               OpDecorate %ubo DescriptorSet 0
               OpDecorate %ubo Binding 0
               OpDecorate %PushBlock Block
               OpMemberDecorate %PushBlock 0 Offset 0
               OpMemberDecorate %PushBlock 1 Offset 16
       %void = OpTypeVoid
       %fn_t = OpTypeFunction %void
        %f32 = OpTypeFloat 32
         %v2 = OpTypeVector %f32 2
         %v4 = OpTypeVector %f32 4
         %m4 = OpTypeMatrix %v4 4
        %i32 = OpTypeInt 32 1
      %i32_0 = OpConstant %i32 0
      %i32_1 = OpConstant %i32 1
   %UboBlock = OpTypeStruct %m4 %v4
  %PushBlock = OpTypeStruct %v4 %v4
   %ptr_in_4 = OpTypePointer Input %v4
   %ptr_in_2 = OpTypePointer Input %v2
  %ptr_out_4 = OpTypePointer Output %v4
  %ptr_out_2 = OpTypePointer Output %v2
    %ptr_ubo = OpTypePointer Uniform %UboBlock
  %ptr_ubo_m = OpTypePointer Uniform %m4
  %ptr_ubo_4 = OpTypePointer Uniform %v4
   %ptr_push = OpTypePointer PushConstant %PushBlock
 %ptr_push_4 = OpTypePointer PushConstant %v4
%gl_Position = OpVariable %ptr_out_4 Output
     %in_pos = OpVariable %ptr_in_4 Input
      %in_uv = OpVariable %ptr_in_2 Input
  %out_color = OpVariable %ptr_out_4 Output
     %out_uv = OpVariable %ptr_out_2 Output
        %ubo = OpVariable %ptr_ubo Uniform
       %push = OpVariable %ptr_push PushConstant
       %main = OpFunction %void None %fn_t
      %entry = OpLabel
        %pos = OpLoad %v4 %in_pos
         %uv = OpLoad %v2 %in_uv
       %p_m  = OpAccessChain %ptr_ubo_m %ubo %i32_0
        %mat = OpLoad %m4 %p_m
      %p_col = OpAccessChain %ptr_ubo_4 %ubo %i32_1
        %col = OpLoad %v4 %p_col
      %p_off = OpAccessChain %ptr_push_4 %push %i32_0
        %off = OpLoad %v4 %p_off
      %p_mul = OpAccessChain %ptr_push_4 %push %i32_1
       %tint = OpLoad %v4 %p_mul
     %pos_tr = OpMatrixTimesVector %v4 %mat %pos
    %pos_out = OpFAdd %v4 %pos_tr %off
    %col_out = OpFMul %v4 %col %tint
               OpStore %gl_Position %pos_out
               OpStore %out_color %col_out
               OpStore %out_uv %uv
               OpReturn
               OpFunctionEnd
