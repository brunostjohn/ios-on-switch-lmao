; SPIR-V
; Version: 1.3
; Bound: 60
               OpCapability Shader
               OpCapability Float16
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %in_uv %out_color
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %in_uv Location 0
               OpDecorate %out_color Location 0
               OpDecorate %tex DescriptorSet 0
               OpDecorate %tex Binding 0
               OpDecorate %samp DescriptorSet 0
               OpDecorate %samp Binding 1
               OpDecorate %UboBlock Block
               OpMemberDecorate %UboBlock 0 Offset 0
               OpDecorate %ubo DescriptorSet 0
               OpDecorate %ubo Binding 2
       %void = OpTypeVoid
       %fn_t = OpTypeFunction %void
        %f16 = OpTypeFloat 16
        %f32 = OpTypeFloat 32
      %v2f32 = OpTypeVector %f32 2
      %v4f32 = OpTypeVector %f32 4
      %v4f16 = OpTypeVector %f16 4
        %i32 = OpTypeInt 32 1
      %i32_0 = OpConstant %i32 0
      %img_t = OpTypeImage %f32 2D 0 0 0 1 Unknown
     %samp_t = OpTypeSampler
   %simg_t   = OpTypeSampledImage %img_t
   %UboBlock = OpTypeStruct %v4f32
   %ptr_in_2 = OpTypePointer Input %v2f32
  %ptr_out_4 = OpTypePointer Output %v4f32
    %ptr_img = OpTypePointer UniformConstant %img_t
   %ptr_samp = OpTypePointer UniformConstant %samp_t
    %ptr_ubo = OpTypePointer Uniform %UboBlock
  %ptr_ubo_4 = OpTypePointer Uniform %v4f32
      %in_uv = OpVariable %ptr_in_2 Input
  %out_color = OpVariable %ptr_out_4 Output
        %tex = OpVariable %ptr_img UniformConstant
       %samp = OpVariable %ptr_samp UniformConstant
        %ubo = OpVariable %ptr_ubo Uniform
       %main = OpFunction %void None %fn_t
      %entry = OpLabel
         %uv = OpLoad %v2f32 %in_uv
        %img = OpLoad %img_t %tex
          %s = OpLoad %samp_t %samp
       %simg = OpSampledImage %simg_t %img %s
      %fetch = OpImageSampleImplicitLod %v4f32 %simg %uv
    %fetch_h = OpFConvert %v4f16 %fetch
       %p_t  = OpAccessChain %ptr_ubo_4 %ubo %i32_0
       %tint = OpLoad %v4f32 %p_t
     %tint_h = OpFConvert %v4f16 %tint
      %mul_h = OpFMul %v4f16 %fetch_h %tint_h
      %out_v = OpFConvert %v4f32 %mul_h
               OpStore %out_color %out_v
               OpReturn
               OpFunctionEnd
