; SPIR-V
; Version: 1.3
; Bound: 100
               OpCapability Shader
       %glsl = OpExtInstImport "GLSL.std.450"
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %in_color %out_color
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %in_color Location 0
               OpDecorate %out_color Location 0
               OpDecorate %UboBlock Block
               OpMemberDecorate %UboBlock 0 Offset 0
               OpMemberDecorate %UboBlock 1 Offset 16
               OpMemberDecorate %UboBlock 2 Offset 32
               OpMemberDecorate %UboBlock 3 Offset 48
               OpDecorate %ubo DescriptorSet 0
               OpDecorate %ubo Binding 0
       %void = OpTypeVoid
       %fn_t = OpTypeFunction %void
        %f32 = OpTypeFloat 32
         %v4 = OpTypeVector %f32 4
        %i32 = OpTypeInt 32 1
      %i32_0 = OpConstant %i32 0
      %i32_1 = OpConstant %i32 1
      %i32_2 = OpConstant %i32 2
      %i32_3 = OpConstant %i32 3
      %f32_1 = OpConstant %f32 1.0
      %v4_1  = OpConstantComposite %v4 %f32_1 %f32_1 %f32_1 %f32_1
   %UboBlock = OpTypeStruct %v4 %v4 %v4 %v4
   %ptr_in_4 = OpTypePointer Input %v4
  %ptr_out_4 = OpTypePointer Output %v4
    %ptr_ubo = OpTypePointer Uniform %UboBlock
  %ptr_ubo_4 = OpTypePointer Uniform %v4
   %in_color = OpVariable %ptr_in_4 Input
  %out_color = OpVariable %ptr_out_4 Output
        %ubo = OpVariable %ptr_ubo Uniform
       %main = OpFunction %void None %fn_t
      %entry = OpLabel
      %p_u0  = OpAccessChain %ptr_ubo_4 %ubo %i32_0
         %u0 = OpLoad %v4 %p_u0
      %p_u1  = OpAccessChain %ptr_ubo_4 %ubo %i32_1
         %u1 = OpLoad %v4 %p_u1
      %p_u2  = OpAccessChain %ptr_ubo_4 %ubo %i32_2
         %u2 = OpLoad %v4 %p_u2
      %p_u3  = OpAccessChain %ptr_ubo_4 %ubo %i32_3
         %u3 = OpLoad %v4 %p_u3
         %s0 = OpExtInst %v4 %glsl Sin %u0
         %c1 = OpExtInst %v4 %glsl Cos %u1
         %a0 = OpFMul %v4 %s0 %u2
         %a1 = OpFAdd %v4 %a0 %c1
         %a2 = OpExtInst %v4 %glsl FAbs %a1
         %a3 = OpFAdd %v4 %a2 %v4_1
         %a4 = OpExtInst %v4 %glsl Sqrt %a3
         %a5 = OpExtInst %v4 %glsl Exp2 %u3
         %a6 = OpFDiv %v4 %a4 %a5
         %a7 = OpExtInst %v4 %glsl Sin %a6
         %a8 = OpExtInst %v4 %glsl Cos %a4
         %fr = OpExtInst %v4 %glsl Fma %a7 %a8 %u0
         %px = OpLoad %v4 %in_color
        %res = OpFMul %v4 %px %fr
               OpStore %out_color %res
               OpReturn
               OpFunctionEnd
