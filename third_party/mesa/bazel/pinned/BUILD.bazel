# What Mesa's own CL and GLSL compilers made for NVK, checked in: this build does not build mesa_clc, vtn_bindgen2 or
# glslangValidator (LLVM, SPIRV-LLVM-Translator, glslang). inputs.txt (astc_spv.h's) and inputs_nvk.txt (nvkcl's) name
# every file they read, by sha256; :inputs_test and :inputs_nvk_test fail when one changes, and then these must be
# regenerated with the real tools.
#
#   nvkcl.spv            mesa_clc of src/nouveau/vulkan/cl/{nvk_query,nvk_copy_indirect}.cl (vtn_bindgen2's input)
#   nvkcl.cpp, nvkcl.h   vtn_bindgen2 of nvkcl.spv (compiled into libnvk)
#   astc_spv.h           glslangValidator -V -S comp -x of src/compiler/glsl/astc_decoder.glsl
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")
load("//third_party/mesa/bazel:defs.bzl", "mesa_files")

package(default_visibility = ["//visibility:public"])

# Generated by Mesa's tools, byte for byte: not ios-on-switch-lmao's to format.
lint_files(exclude = [
    "astc_spv.h",
    "nvkcl.cpp",
    "nvkcl.h",
])

exports_files([
    "astc_spv.h",
    "nvkcl.cpp",
    "nvkcl.h",
    "nvkcl.spv",
])

# The generated input, made in NVK's configuration (the host twin's: it is the same file for both).
mesa_files(
    name = "generated_inputs",
    srcs = ["//third_party/mesa/src/nouveau/headers:nv_push_cl90b5.h"],
    platform = "macos",
)

# Everything inputs.txt names: astc_spv.h's inputs
py_test(
    name = "inputs_test",
    size = "small",
    srcs = ["check_inputs.py"],
    args = [
        "$(rootpath inputs.txt)",
        "third_party/mesa",
        "third_party/mesa",
    ],
    data = [
        "inputs.txt",
        "//third_party/mesa/src/compiler:glsl/astc_decoder.glsl",
    ],
    main = "check_inputs.py",
)

# Everything inputs_nvk.txt names: nvkcl.*'s inputs (in the runfiles both the sources and the generated header sit under
# third_party/mesa). m2v: NVK's CL programs, deleted with NVK.
py_test(
    name = "inputs_nvk_test",
    size = "small",
    srcs = ["check_inputs.py"],
    args = [
        "$(rootpath inputs_nvk.txt)",
        "third_party/mesa",
        "third_party/mesa",
    ],
    data = [
        "inputs_nvk.txt",
        ":generated_inputs",
        "//third_party/mesa/src/compiler:libcl/assert.h",
        "//third_party/mesa/src/compiler:libcl/libcl.h",
        "//third_party/mesa/src/compiler:libcl/libcl_vk.h",
        "//third_party/mesa/src/compiler:libcl/stdalign.h",
        "//third_party/mesa/src/compiler:libcl/stdbool.h",
        "//third_party/mesa/src/compiler:libcl/stddef.h",
        "//third_party/mesa/src/compiler:libcl/stdint.h",
        "//third_party/mesa/src/compiler:libcl/stdio.h",
        "//third_party/mesa/src/compiler:libcl/stdlib.h",
        "//third_party/mesa/src/compiler:libcl/string.h",
        "//third_party/mesa/src/nouveau/headers:drf.h",
        "//third_party/mesa/src/nouveau/headers:nv_push.h",
        "//third_party/mesa/src/nouveau/headers:nvidia/classes/cl906f.h",
        "//third_party/mesa/src/nouveau/headers:nvidia/classes/cl90b5.h",
        "//third_party/mesa/src/nouveau/headers:nvtypes.h",
        "//third_party/mesa/src/nouveau/vulkan:cl/nvk_copy_indirect.cl",
        "//third_party/mesa/src/nouveau/vulkan:cl/nvk_copy_indirect.h",
        "//third_party/mesa/src/nouveau/vulkan:cl/nvk_query.cl",
        "//third_party/mesa/src/nouveau/vulkan:cl/nvk_query.h",
        "//third_party/mesa/src/util:macros.h",
    ],
    main = "check_inputs.py",
    tags = ["m2v"],
)
