diff --git a/pkg/slots/directory.go b/pkg/slots/directory.go
new file mode 100644
index 0000000..91180b9
--- /dev/null
+++ b/pkg/slots/directory.go
@@ -0,0 +1,72 @@
+package slots
+
+import (
+	"os"
+
+	"github.com/buildbarn/bb-storage/pkg/filesystem/path"
+
+	"golang.org/x/sys/unix"
+)
+
+func openDirectory(parentFD int, name string) (*os.File, error) {
+	fd, err := unix.Openat(parentFD, name, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, err
+	}
+	return os.NewFile(uintptr(fd), name), nil
+}
+
+// removeEntry removes a file, or a directory and everything in it, also
+// when an action took the owner's permissions away from a directory.
+func removeEntry(directoryFD int, name string, isDirectory bool) error {
+	if !isDirectory {
+		return ignoreNotExist(unix.Unlinkat(directoryFD, name, 0))
+	}
+	if err := unix.Fchmodat(directoryFD, name, 0o700, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return ignoreNotExist(err)
+	}
+	directory, err := openDirectory(directoryFD, name)
+	if err != nil {
+		return ignoreNotExist(err)
+	}
+	entries, err := directory.ReadDir(-1)
+	for _, entry := range entries {
+		if err != nil {
+			break
+		}
+		err = removeEntry(int(directory.Fd()), entry.Name(), entry.IsDir())
+	}
+	directory.Close()
+	if err != nil {
+		return err
+	}
+	return ignoreNotExist(unix.Unlinkat(directoryFD, name, unix.AT_REMOVEDIR))
+}
+
+func ignoreNotExist(err error) error {
+	if err == unix.ENOENT {
+		return nil
+	}
+	return err
+}
+
+// localSymlinkTarget converts a symlink target the way
+// filesystem.Directory.Symlink() does, so that it can be compared with
+// what readlink returns.
+func localSymlinkTarget(target string) (string, error) {
+	targetPath, scopeWalker := path.EmptyBuilder.Join(path.VoidScopeWalker)
+	if err := path.Resolve(path.UNIXFormat.NewParser(target), scopeWalker); err != nil {
+		return "", err
+	}
+	return path.LocalFormat.GetString(targetPath)
+}
+
+func symlinkPointsAt(directoryFD int, name, target string) bool {
+	want, err := localSymlinkTarget(target)
+	if err != nil {
+		return false
+	}
+	buffer := make([]byte, len(want)+1)
+	n, err := unix.Readlinkat(directoryFD, name, buffer)
+	return err == nil && string(buffer[:n]) == want
+}
diff --git a/pkg/slots/input_root.go b/pkg/slots/input_root.go
new file mode 100644
index 0000000..6c5c641
--- /dev/null
+++ b/pkg/slots/input_root.go
@@ -0,0 +1,377 @@
+package slots
+
+import (
+	"context"
+	"io/fs"
+	"os"
+	"sync"
+
+	remoteexecution "github.com/bazelbuild/remote-apis/build/bazel/remote/execution/v2"
+	re_cas "github.com/buildbarn/bb-remote-execution/pkg/cas"
+	"github.com/buildbarn/bb-storage/pkg/digest"
+	"github.com/buildbarn/bb-storage/pkg/filesystem"
+	"github.com/buildbarn/bb-storage/pkg/filesystem/path"
+	"github.com/buildbarn/bb-storage/pkg/util"
+	"github.com/prometheus/client_golang/prometheus"
+
+	"golang.org/x/sync/errgroup"
+	"golang.org/x/sync/semaphore"
+	"golang.org/x/sys/unix"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+var (
+	inputRootPrometheusMetrics sync.Once
+
+	inputRootFiles = prometheus.NewCounterVec(
+		prometheus.CounterOpts{
+			Namespace: "buildbarn",
+			Subsystem: "builder",
+			Name:      "slot_input_root_files_total",
+			Help:      "Input root entries an executor's slot kept in place, placed, or removed.",
+		},
+		[]string{"outcome"})
+	inputRootFilesKept             = inputRootFiles.WithLabelValues("kept")
+	inputRootFilesPlaced           = inputRootFiles.WithLabelValues("placed")
+	inputRootFilesPlacedExecutable = inputRootFiles.WithLabelValues("placed_executable")
+	inputRootEntriesRemoved        = inputRootFiles.WithLabelValues("removed")
+)
+
+type placedFile struct {
+	hash         string
+	sizeBytes    int64
+	isExecutable bool
+
+	// Set once the file is in place. An action that writes, replaces
+	// or chmods the file changes at least one of them. A zero inode
+	// matches no file, so a placement that never finished is redone.
+	inode            uint64
+	modificationTime unix.Timespec
+	mode             uint16
+}
+
+func (f *placedFile) describes(node *remoteexecution.FileNode) bool {
+	return node.Digest != nil && f.hash == node.Digest.Hash && f.sizeBytes == node.Digest.SizeBytes && f.isExecutable == node.IsExecutable
+}
+
+func (f *placedFile) matches(stat *unix.Stat_t) bool {
+	return f.inode != 0 && stat.Ino == f.inode && stat.Size == f.sizeBytes && stat.Mtim == f.modificationTime && stat.Mode == f.mode
+}
+
+func (f *placedFile) recordPlacement(filePath string) error {
+	var stat unix.Stat_t
+	if err := unix.Lstat(filePath, &stat); err != nil {
+		return err
+	}
+	f.inode = stat.Ino
+	f.modificationTime = stat.Mtim
+	f.mode = stat.Mode
+	return nil
+}
+
+type placedDirectory struct {
+	files       map[string]*placedFile
+	directories map[string]*placedDirectory
+}
+
+func newPlacedDirectory() *placedDirectory {
+	return &placedDirectory{
+		files:       map[string]*placedFile{},
+		directories: map[string]*placedDirectory{},
+	}
+}
+
+// inputRoot is the input root of one slot, with a record of every file
+// placed in it. Anything on disk without a matching record is removed.
+type inputRoot struct {
+	path                 string
+	directoryFetcher     re_cas.DirectoryFetcher
+	fileFetcher          re_cas.FileFetcher
+	fileFetcherSemaphore *semaphore.Weighted
+
+	digestFunction remoteexecution.DigestFunction_Value
+	directoryMode  uint32
+	placed         *placedDirectory
+}
+
+func newInputRoot(inputRootPath string, directoryFetcher re_cas.DirectoryFetcher, fileFetcher re_cas.FileFetcher, fileFetcherSemaphore *semaphore.Weighted) *inputRoot {
+	inputRootPrometheusMetrics.Do(func() {
+		prometheus.MustRegister(inputRootFiles)
+	})
+	return &inputRoot{
+		path:                 inputRootPath,
+		directoryFetcher:     directoryFetcher,
+		fileFetcher:          fileFetcher,
+		fileFetcherSemaphore: fileFetcherSemaphore,
+	}
+}
+
+// reset forgets every placed file, and takes the mode of the freshly
+// created input root as the mode every input directory gets back.
+func (r *inputRoot) reset() error {
+	var stat unix.Stat_t
+	if err := unix.Lstat(r.path, &stat); err != nil {
+		return err
+	}
+	r.directoryMode = uint32(stat.Mode) & 0o7777
+	r.placed = newPlacedDirectory()
+	return nil
+}
+
+func (r *inputRoot) populate(ctx context.Context, rootDigest digest.Digest) error {
+	digestFunction := rootDigest.GetDigestFunction()
+	if r.placed == nil {
+		if err := r.reset(); err != nil {
+			return util.StatusWrapWithCode(err, codes.Internal, "Failed to inspect input root")
+		}
+	}
+	if enumValue := digestFunction.GetEnumValue(); enumValue != r.digestFunction {
+		r.digestFunction = enumValue
+		r.placed = newPlacedDirectory()
+	}
+	if err := r.restoreDirectoryMode(unix.AT_FDCWD, r.path); err != nil {
+		return util.StatusWrapWithCode(err, codes.Internal, "Failed to restore input root permissions")
+	}
+	root, err := openDirectory(unix.AT_FDCWD, r.path)
+	if err != nil {
+		return util.StatusWrapWithCode(err, codes.Internal, "Failed to open input root")
+	}
+
+	p := populator{inputRoot: r, digestFunction: digestFunction}
+	group, groupCtx := errgroup.WithContext(ctx)
+	group.Go(func() error {
+		defer root.Close()
+		return p.mergeDirectory(groupCtx, group, root, r.path, rootDigest, r.placed, nil)
+	})
+	err = group.Wait()
+	inputRootFilesKept.Add(float64(p.kept))
+	inputRootFilesPlaced.Add(float64(p.placed))
+	inputRootFilesPlacedExecutable.Add(float64(p.placedExecutable))
+	inputRootEntriesRemoved.Add(float64(p.removed))
+	return err
+}
+
+func (r *inputRoot) restoreDirectoryMode(parentFD int, name string) error {
+	var stat unix.Stat_t
+	if err := unix.Fstatat(parentFD, name, &stat, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return err
+	}
+	if uint32(stat.Mode)&0o7777 == r.directoryMode {
+		return nil
+	}
+	return unix.Fchmodat(parentFD, name, r.directoryMode, unix.AT_SYMLINK_NOFOLLOW)
+}
+
+// populator reconciles an input root with one action's input root. Its
+// counts are only touched by the goroutine walking the tree.
+type populator struct {
+	*inputRoot
+	digestFunction digest.Function
+
+	kept             int
+	placed           int
+	placedExecutable int
+	removed          int
+}
+
+func (p *populator) mergeDirectory(ctx context.Context, group *errgroup.Group, directory *os.File, directoryPath string, directoryDigest digest.Digest, placed *placedDirectory, pathTrace *path.Trace) error {
+	want, err := p.directoryFetcher.GetDirectory(ctx, directoryDigest)
+	if err != nil {
+		return util.StatusWrapf(err, "Failed to obtain input directory %#v", pathTrace.GetUNIXString())
+	}
+	existing, err := directory.ReadDir(-1)
+	if err != nil {
+		return util.StatusWrapfWithCode(err, codes.Internal, "Failed to read input directory %#v", pathTrace.GetUNIXString())
+	}
+	keptSymlinks, err := p.prune(int(directory.Fd()), directoryPath, existing, want, placed)
+	if err != nil {
+		return err
+	}
+	if err := p.placeFiles(ctx, group, directoryPath, want.Files, placed, pathTrace); err != nil {
+		return err
+	}
+	if err := p.createSymlinks(int(directory.Fd()), want.Symlinks, keptSymlinks, pathTrace); err != nil {
+		return err
+	}
+	return p.mergeDirectories(ctx, group, int(directory.Fd()), directoryPath, want.Directories, placed, pathTrace)
+}
+
+// prune keeps the entries the action wants that are still as they were
+// placed, and removes every other entry. It leaves in placed only the
+// records of what it kept.
+func (p *populator) prune(directoryFD int, directoryPath string, existing []fs.DirEntry, want *remoteexecution.Directory, placed *placedDirectory) (map[string]struct{}, error) {
+	wantFiles := make(map[string]*remoteexecution.FileNode, len(want.Files))
+	for _, file := range want.Files {
+		wantFiles[file.Name] = file
+	}
+	wantDirectories := make(map[string]struct{}, len(want.Directories))
+	for _, child := range want.Directories {
+		wantDirectories[child.Name] = struct{}{}
+	}
+	wantSymlinks := make(map[string]string, len(want.Symlinks))
+	for _, symlink := range want.Symlinks {
+		wantSymlinks[symlink.Name] = symlink.Target
+	}
+
+	oldFiles, oldDirectories := placed.files, placed.directories
+	placed.files = make(map[string]*placedFile, len(want.Files))
+	placed.directories = make(map[string]*placedDirectory, len(want.Directories))
+	keptSymlinks := map[string]struct{}{}
+	for _, entry := range existing {
+		name := entry.Name()
+		switch entryType := entry.Type(); {
+		case entryType.IsRegular():
+			if node, ok := wantFiles[name]; ok {
+				if file, ok := oldFiles[name]; ok && file.describes(node) {
+					var stat unix.Stat_t
+					if unix.Fstatat(directoryFD, name, &stat, unix.AT_SYMLINK_NOFOLLOW) == nil && file.matches(&stat) {
+						placed.files[name] = file
+						p.kept++
+						continue
+					}
+				}
+			}
+		case entryType.IsDir():
+			if _, ok := wantDirectories[name]; ok {
+				child, ok := oldDirectories[name]
+				if !ok {
+					child = newPlacedDirectory()
+				}
+				placed.directories[name] = child
+				continue
+			}
+		case entryType&fs.ModeSymlink != 0:
+			if target, ok := wantSymlinks[name]; ok && symlinkPointsAt(directoryFD, name, target) {
+				keptSymlinks[name] = struct{}{}
+				continue
+			}
+		}
+		if err := removeEntry(directoryFD, name, entry.IsDir()); err != nil {
+			return nil, util.StatusWrapfWithCode(err, codes.Internal, "Failed to remove %#v", directoryPath+"/"+name)
+		}
+		p.removed++
+	}
+	return keptSymlinks, nil
+}
+
+func (p *populator) placeFiles(ctx context.Context, group *errgroup.Group, directoryPath string, files []*remoteexecution.FileNode, placed *placedDirectory, pathTrace *path.Trace) error {
+	var target *filesystem.ReferenceCountedDirectoryCloser
+	defer func() {
+		if target != nil {
+			target.Close()
+		}
+	}()
+	for _, file := range files {
+		if _, ok := placed.files[file.Name]; ok {
+			continue
+		}
+		component, ok := path.NewComponent(file.Name)
+		if !ok {
+			return status.Errorf(codes.InvalidArgument, "File %#v has an invalid name", file.Name)
+		}
+		childPathTrace := pathTrace.Append(component)
+		fileDigest, err := p.digestFunction.NewDigestFromProto(file.Digest)
+		if err != nil {
+			return util.StatusWrapf(err, "Failed to extract digest for input file %#v", childPathTrace.GetUNIXString())
+		}
+		if target == nil {
+			directory, err := filesystem.NewLocalDirectory(path.LocalFormat.NewParser(directoryPath))
+			if err != nil {
+				return util.StatusWrapfWithCode(err, codes.Internal, "Failed to open input directory %#v", pathTrace.GetUNIXString())
+			}
+			target = filesystem.NewReferenceCountedDirectoryCloser(directory)
+		}
+
+		record := &placedFile{
+			hash:         fileDigest.GetHashString(),
+			sizeBytes:    fileDigest.GetSizeBytes(),
+			isExecutable: file.IsExecutable,
+		}
+		placed.files[file.Name] = record
+		p.placed++
+		if file.IsExecutable {
+			p.placedExecutable++
+		}
+
+		if err := util.AcquireSemaphore(ctx, p.fileFetcherSemaphore, 1); err != nil {
+			return err
+		}
+		targetDirectory := target.Duplicate()
+		filePath := directoryPath + "/" + file.Name
+		isExecutable := file.IsExecutable
+		group.Go(func() error {
+			err := p.fileFetcher.GetFile(ctx, fileDigest, targetDirectory, component, isExecutable)
+			if err == nil {
+				err = record.recordPlacement(filePath)
+			}
+			errClose := targetDirectory.Close()
+			p.fileFetcherSemaphore.Release(1)
+			if err != nil {
+				return util.StatusWrapf(err, "Failed to obtain input file %#v", childPathTrace.GetUNIXString())
+			}
+			if errClose != nil {
+				return util.StatusWrapf(errClose, "Failed to close input directory %#v", pathTrace.GetUNIXString())
+			}
+			return nil
+		})
+	}
+	return nil
+}
+
+func (p *populator) createSymlinks(directoryFD int, symlinks []*remoteexecution.SymlinkNode, keptSymlinks map[string]struct{}, pathTrace *path.Trace) error {
+	for _, symlink := range symlinks {
+		if _, ok := keptSymlinks[symlink.Name]; ok {
+			continue
+		}
+		component, ok := path.NewComponent(symlink.Name)
+		if !ok {
+			return status.Errorf(codes.InvalidArgument, "Symlink %#v has an invalid name", symlink.Name)
+		}
+		childPathTrace := pathTrace.Append(component)
+		target, err := localSymlinkTarget(symlink.Target)
+		if err != nil {
+			return util.StatusWrapfWithCode(err, codes.InvalidArgument, "Invalid target for input symlink %#v", childPathTrace.GetUNIXString())
+		}
+		if err := unix.Symlinkat(target, directoryFD, symlink.Name); err != nil {
+			return util.StatusWrapf(err, "Failed to create input symlink %#v", childPathTrace.GetUNIXString())
+		}
+	}
+	return nil
+}
+
+func (p *populator) mergeDirectories(ctx context.Context, group *errgroup.Group, directoryFD int, directoryPath string, directories []*remoteexecution.DirectoryNode, placed *placedDirectory, pathTrace *path.Trace) error {
+	for _, child := range directories {
+		component, ok := path.NewComponent(child.Name)
+		if !ok {
+			return status.Errorf(codes.InvalidArgument, "Directory %#v has an invalid name", child.Name)
+		}
+		childPathTrace := pathTrace.Append(component)
+		childDigest, err := p.digestFunction.NewDigestFromProto(child.Digest)
+		if err != nil {
+			return util.StatusWrapf(err, "Failed to extract digest for input directory %#v", childPathTrace.GetUNIXString())
+		}
+		childPlaced, kept := placed.directories[child.Name]
+		if kept {
+			err = p.restoreDirectoryMode(directoryFD, child.Name)
+		} else {
+			childPlaced = newPlacedDirectory()
+			placed.directories[child.Name] = childPlaced
+			err = unix.Mkdirat(directoryFD, child.Name, 0o777)
+		}
+		if err != nil {
+			return util.StatusWrapf(err, "Failed to create input directory %#v", childPathTrace.GetUNIXString())
+		}
+		childDirectory, err := openDirectory(directoryFD, child.Name)
+		if err != nil {
+			return util.StatusWrapf(err, "Failed to enter input directory %#v", childPathTrace.GetUNIXString())
+		}
+		err = p.mergeDirectory(ctx, group, childDirectory, directoryPath+"/"+child.Name, childDigest, childPlaced, childPathTrace)
+		childDirectory.Close()
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
