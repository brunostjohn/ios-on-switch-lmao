# The GPU experiment loop with HW Test's Bench screen (README.md): batches over USB, results back, the analyses.
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//tools:__subpackages__"])

lint_files()

exports_files(
    ["testdata/golden_batch.json"],
    visibility = ["//hw_test_app:__pkg__"],
)

py_library(
    name = "protocol",
    srcs = ["protocol.py"],
)

py_library(
    name = "lib",
    srcs = [
        "blend.py",
        "blend_models.py",
        "columns.py",
        "doctor.py",
        "fakeblend.py",
        "fakedevice.py",
        "fakegpu.py",
        "formula.py",
        "golden.py",
        "known.py",
        "loop.py",
        "report.py",
        "rop.py",
        "session.py",
        "sweeps.py",
        "texels.py",
        "transport.py",
    ],
    deps = [
        ":protocol",
        "//tools/benchloop/sm53:encode",
        "//tools/benchloop/sm53:fit",
        "//tools/benchloop/sm53:latency",
        "//tools/benchloop/sm53:program",
        "//tools/benchloop/sm53:sph",
        "//tools/benchloop/sm53:timing_sim",
        "//tools/gpu/maxwell:interp",
    ],
)

# bazel run //tools/benchloop -- doctor | latency | blend <table> | rop | run <batch> (README.md)
py_binary(
    name = "benchloop",
    srcs = ["benchloop.py"],
    deps = [":lib"],
)

# The app's side of the format: its decoder's limits (Swift), its GPU side's method ranges (C++), its known program
APP_SOURCES = [
    "//hw_test_app:bench/bench_known.h",
    "//hw_test_app:bench/bench_records.cpp",
    "//hw_test_app:test_sources",
]

[
    py_test(
        name = name,
        size = "small",
        srcs = [name + ".py"],
        data = APP_SOURCES + glob(["testdata/*"]),
        deps = [
            ":lib",
            "//tools/gpu/maxwell:interp",
            "//tools/gpu/maxwell:isa",
        ],
    )
    for name in [
        "agreement_test",
        "blend_models_test",
        "blend_test",
        "golden_test",
        "known_test",
        "loop_test",
        "rop_test",
        "sweeps_test",
        "transport_test",
    ]
]

# bazel run //tools/benchloop:rung3 -- <dir>: fetch rung 3's iterated blend programs as bench tables (rung3.py)
py_library(
    name = "rung3_lib",
    srcs = ["rung3.py"],
    deps = ["//drivers/TegraGM20BMetal:raw_pack"],
)

py_binary(
    name = "rung3",
    srcs = ["rung3.py"],
    deps = [":rung3_lib"],
)

py_test(
    name = "rung3_test",
    size = "small",
    srcs = ["rung3_test.py"],
    deps = [
        ":lib",
        ":rung3_lib",
    ],
)
