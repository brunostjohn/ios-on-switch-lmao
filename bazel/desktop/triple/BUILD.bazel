# One config_setting per desktop target triple, the select() keys of @installer_crates (its render_config,
# install/crates/crates.MODULE.bazel). rules_rust 0.75.0's own, @rules_rust//rust/platform, have no musl triples.
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

[config_setting(
    name = triple,
    constraint_values = [
        "@platforms//os:" + os,
        "@platforms//cpu:" + cpu,
    ],
) for triple, os, cpu in [
    ("aarch64-apple-darwin", "osx", "aarch64"),
    ("aarch64-pc-windows-msvc", "windows", "aarch64"),
    ("aarch64-unknown-linux-musl", "linux", "aarch64"),
    ("x86_64-apple-darwin", "osx", "x86_64"),
    ("x86_64-pc-windows-msvc", "windows", "x86_64"),
    ("x86_64-unknown-linux-musl", "linux", "x86_64"),
]]
