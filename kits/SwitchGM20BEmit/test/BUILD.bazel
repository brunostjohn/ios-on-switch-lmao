# kits/SwitchGM20BEmit on the host: its words against the drivers' emitters for the same inputs.
#
#   bazel test //kits/SwitchGM20BEmit/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_test")
load("//kernel/rules:kernel.bzl", "kernel_driver")
load("//kits/SwitchGM20BEmit:defs.bzl", "EMIT_SOURCES", "SWITCH_GM20B_EMIT_INCLUDES")

lint_files()

# The kit's C, with the tests' flags (warnings as errors, sanitizers).
host_library(
    name = "emit",
    srcs = [
        "//kits/SwitchGM20BEmit:SwitchGM20BEmit3D.c",
        "//kits/SwitchGM20BEmit:SwitchGM20BEmitBarrier.c",
        "//kits/SwitchGM20BEmit:mesa/nouveau_copy_rect.c",
    ],
    hdrs = [
        "//kits/SwitchGM20BEmit:SwitchGM20BEmit3D.h",
        "//kits/SwitchGM20BEmit:SwitchGM20BEmitBarrier.h",
        "//kits/SwitchGM20BEmit:SwitchGM20BEmitCopy.h",
        "//kits/SwitchGM20BEmit:SwitchGM20BPushDecode.h",
    ],
    deps = ["//kits/SwitchGM20BEmit:push"],
)

host_test(
    name = "emit_copy_test",
    srcs = [
        "emit_copy_test.cpp",
        "push_words.h",
        "//drivers/TegraGM20B:TegraGM20BABI.h",
        "//drivers/TegraGM20B:TegraGM20BCopy.h",
        "//drivers/TegraGM20B:TegraGM20BCopyPush.h",
        "//drivers/TegraGM20B:TegraGM20BFences.h",
        "//drivers/TegraGM20B:TegraGM20BGpu.h",
        "//drivers/TegraGM20B:TegraGM20BLayout.h",
        "//drivers/TegraGM20B:TegraGM20BRelayout.h",
        "//drivers/TegraGM20B:TegraGM20BSyncpt.h",
        "//drivers/TegraGM20BMetal:raw/runtime/raw_copy.h",
        "//drivers/TegraGM20BMetal:raw/runtime/raw_push.h",
    ],
    deps = [":emit"],
)

host_test(
    name = "emit_3d_test",
    srcs = [
        "emit_3d_test.cpp",
        "push_words.h",
        "//drivers/TegraGM20B:TegraGM20BLayout.h",
        "//drivers/TegraGM20BMetal:raw/fx/fx_mip.h",
        "//drivers/TegraGM20BMetal:raw/runtime/raw_emit.cpp",
        "//drivers/TegraGM20BMetal:raw/runtime/raw_emit.h",
        "//drivers/TegraGM20BMetal:raw/runtime/raw_push.h",
        "//drivers/TegraGM20BMetal:raw/runtime/raw_sample_shading.h",
        "//drivers/TegraGM20BMetal:raw/runtime/raw_target.h",
        "//kits/SwitchGM20B/test:driver_constants_h",
    ],
    copts = ["-Idrivers/TegraGM20B"],
    data = ["//drivers/TegraGM20BMetal:raw/runtime/raw_gpu.cpp"],
    deps = [
        ":emit",
        "//kits/SwitchGM20B:classes",
    ],
)

# The kit compiled by the kernel toolchain, C and C++: never linked, built so the kernel's headers and flags keep taking it.
kernel_driver(
    name = "SwitchGM20BEmitKernelCheck",
    srcs = ["//kits/SwitchGM20BEmit:" + s for s in EMIT_SOURCES] + [
        "kernel_check.c",
        "kernel_check_cxx.cpp",
    ],
    c_copts = SWITCH_GM20B_EMIT_INCLUDES,
    copts = SWITCH_GM20B_EMIT_INCLUDES,
    hdr_deps = [
        "kits/SwitchGM20B",
        "kits/SwitchGM20BEmit",
    ],
    tags = ["no-lint"],
)
