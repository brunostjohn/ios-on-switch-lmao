# NVIDIA falcon firmware images and boot for VIC, NVDEC, NVENC and NVJPG.
#
#   bazel test //kits/SwitchFalcon/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//kernel/rules:kernel.bzl", "kernel_driver", "kernel_headers")

package(default_visibility = ["//visibility:public"])

lint_files()

exports_files(glob(
    ["**"],
    exclude = ["BUILD.bazel"],
))

filegroup(
    name = "all_files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
)

kernel_headers()

kernel_driver(
    name = "SwitchFalcon",
    srcs = [
        "SwitchFalcon.cpp",
        "SwitchFalconInterrupt.cpp",
    ],
    hdr_deps = [
        "drivers/ArmGIC",
        "kits/SwitchMMIO",
    ],
)
