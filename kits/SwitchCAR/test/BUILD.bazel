# kits/SwitchCAR on the host, against a model of the CAR banks and the PMC's toggle handshake, and the UPHY PLL's
# announcements (SwitchUPHY.h).
#
#   bazel test //kits/SwitchCAR/test:all
load("//bazel/lint:defs.bzl", "lint_files")
load("//bazel/testing:defs.bzl", "host_library", "host_shims", "host_test")

lint_files()

host_shims(
    name = "kernel",
    headers = [
        "IOKit/IOLib.h",
        "kern/clock.h",
    ],
    stubs = "switch_car_stubs.h",
)

host_library(
    name = "car",
    srcs = [
        "//kits/SwitchCAR:SwitchCAR.cpp",
        "//kits/SwitchCAR:SwitchCAR.h",
        "//kits/SwitchCAR:SwitchPMC.h",
        "//kits/SwitchMMIO:SwitchMMIO.h",
        "//kits/SwitchMMIO:SwitchMMIOKernel.h",
    ],
    defines = ["SWITCH_MMIO_HOST_MODEL=1"],
    deps = [":kernel"],
)

host_test(
    name = "switch_car_test",
    srcs = [
        "switch_car_test.cpp",
        "//kits/SwitchCAR:SwitchCAR.h",
        "//kits/SwitchCAR:SwitchPMC.h",
    ],
    deps = [
        ":car",
        ":kernel",
    ],
)

# SwitchUPHY.h: the UPHY PLL's calibration announcements and the lane protocol on top of them.
host_test(
    name = "switch_uphy_test",
    srcs = [
        "switch_uphy_test.cpp",
        "//kits/SwitchCAR:SwitchUPHY.cpp",
        "//kits/SwitchCAR:SwitchUPHY.h",
    ],
)

# SwitchEngineClock.h: the 637 mV rate per SoC process and PLLC2/PLLC3's bring-up against a model of their registers.
host_library(
    name = "engine_clock",
    srcs = [
        "//kits/SwitchCAR:SwitchCAR.cpp",
        "//kits/SwitchCAR:SwitchCAR.h",
        "//kits/SwitchCAR:SwitchEngineClock.cpp",
        "//kits/SwitchCAR:SwitchEngineClock.h",
        "//kits/SwitchCAR:SwitchEngineClockPlan.h",
        "//kits/SwitchCAR:SwitchPMC.h",
        "//kits/SwitchMMIO:SwitchMMIO.h",
        "//kits/SwitchMMIO:SwitchMMIOKernel.h",
    ],
    defines = [
        "DEVELOPMENT=1",
        "SWITCH_MMIO_HOST_MODEL=1",
    ],
    deps = [":kernel"],
)

host_test(
    name = "switch_engine_clock_test",
    srcs = [
        "switch_engine_clock_test.cpp",
        "//kits/SwitchCAR:SwitchEngineClock.h",
        "//kits/SwitchCAR:SwitchEngineClockPlan.h",
    ],
    deps = [
        ":engine_clock",
        ":kernel",
    ],
)

# The kit as the one writer of shared CAR and PMC words, against a register file on a clock whose lock lets a second
# driver's step land inside another's (switch_car_owner_model.h), and every driver's and kit's source.
host_shims(
    name = "owner_kernel",
    headers = [
        "IOKit/IOLib.h",
        "kern/clock.h",
    ],
    stubs = "switch_car_owner_stubs.h",
)

host_library(
    name = "owner_car",
    srcs = [
        "//kits/SwitchCAR:SwitchCAR.cpp",
        "//kits/SwitchCAR:SwitchCAR.h",
        "//kits/SwitchCAR:SwitchPMC.h",
        "//kits/SwitchMMIO:SwitchMMIO.h",
        "//kits/SwitchMMIO:SwitchMMIOKernel.h",
    ],
    defines = ["SWITCH_MMIO_HOST_MODEL=1"],
    deps = [":owner_kernel"],
)

host_test(
    name = "switch_car_fuse_owner_test",
    srcs = [
        "switch_car_fuse_owner_test.cpp",
        "switch_car_owner_model.cpp",
        "switch_car_owner_model.h",
        "//kits/SwitchCAR:SwitchCAR.h",
    ],
    data = ["//kernel:lint_sources"],
    deps = [
        ":owner_car",
        ":owner_kernel",
    ],
)

host_test(
    name = "switch_pmc_pads_owner_test",
    srcs = [
        "switch_car_owner_model.cpp",
        "switch_car_owner_model.h",
        "switch_pmc_pads_owner_test.cpp",
        "//kits/SwitchCAR:SwitchPMC.h",
    ],
    data = ["//kernel:lint_sources"],
    deps = [
        ":owner_car",
        ":owner_kernel",
    ],
)

host_test(
    name = "switch_pmc_dpd_owner_test",
    srcs = [
        "switch_car_owner_model.cpp",
        "switch_car_owner_model.h",
        "switch_pmc_dpd_owner_test.cpp",
        "//kits/SwitchCAR:SwitchPMC.h",
    ],
    data = ["//kernel:lint_sources"],
    deps = [
        ":owner_car",
        ":owner_kernel",
    ],
)
