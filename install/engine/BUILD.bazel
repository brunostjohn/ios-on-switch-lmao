# switch_engine: desktop installer engine wiring fetch, decode, boot, pretranslate, APFS image assembly,
# partitioning, card table updates, and FAT boot file installation.
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

_DEPS = [
    "//install/aea:switch_aea",
    "//install/apfs_format:switch_apfs_format",
    "//install/apfs_names:switch_apfs_names",
    "//install/apfs_read:switch_apfs_read",
    "//install/apfs_seal:switch_apfs_seal",
    "//install/apfs_write:switch_apfs_write",
    "//install/boot:switch_boot",
    "//install/card:switch_card",
    "//install/catalog:switch_catalog",
    "//install/decmpfs:switch_decmpfs",
    "//install/disk:switch_disk",
    "//install/fetch:switch_fetch",
    "//install/image:switch_image",
    "//install/image_bootstrap:switch_image_bootstrap",
    "//install/image_gpu:switch_image_gpu",
    "//install/image_overlay:switch_image_overlay",
    "//install/image_pretranslated:switch_image_pretranslated",
    "//install/img4:switch_img4",
    "//install/installd:switch_installd",
    "//install/ipsw:switch_ipsw",
    "//install/partition:switch_partition",
    "//install/sd:switch_sd",
    "//install/seed:switch_seed",
    "//install/translate:switch_translate",
    "@installer_crates//:hex",
    "@installer_crates//:reqwest",
    "@installer_crates//:serde",
    "@installer_crates//:serde_json",
    "@installer_crates//:sha2",
    "@installer_crates//:tar",
    "@installer_crates//:thiserror",
    "@installer_crates//:tokio",
]

rust_library(
    name = "switch_engine",
    srcs = [
        "src/assemble.rs",
        "src/boot.rs",
        "src/decode.rs",
        "src/error.rs",
        "src/fetch.rs",
        "src/gpu_seed.rs",
        "src/lib.rs",
        "src/modes.rs",
        "src/paths.rs",
        "src/pretranslate.rs",
        "src/probe.rs",
        "src/progress.rs",
        "src/resume.rs",
        "src/target.rs",
    ],
    crate_root = "src/lib.rs",
    deps = _DEPS,
)

rust_test(
    name = "switch_engine_test",
    size = "medium",
    srcs = [
        "tests/assets_e2e.rs",
        "tests/e2e.rs",
        "tests/engine_test.rs",
        "tests/seed_e2e.rs",
        "tests/synth_apfs.rs",
        "tests/synth_cryptex.rs",
        "tests/synth_fat.rs",
        "tests/synth_fixture.rs",
    ],
    crate_root = "tests/engine_test.rs",
    deps = [
        ":switch_engine",
        "//install/apfs_alloc:switch_apfs_alloc",
        "//install/apfs_btree:switch_apfs_btree",
        "//install/apfs_format:switch_apfs_format",
        "//install/apfs_names:switch_apfs_names",
        "//install/apfs_read:switch_apfs_read",
        "//install/apfs_seal:switch_apfs_seal",
        "//install/apfs_write:switch_apfs_write",
        "//install/card:switch_card",
        "//install/catalog:switch_catalog",
        "//install/image:switch_image",
        "//install/image_bootstrap:switch_image_bootstrap",
        "//install/image_gpu:switch_image_gpu",
        "//install/partition:switch_partition",
        "//install/sd:switch_sd",
        "//install/seed:switch_seed",
        "@installer_crates//:crc32fast",
        "@installer_crates//:flate2",
        "@installer_crates//:hadris-fat",
        "@installer_crates//:hex",
        "@installer_crates//:plist",
        "@installer_crates//:serde_json",
        "@installer_crates//:sha2",
        "@installer_crates//:tar",
        "@installer_crates//:tempfile",
        "@installer_crates//:zerocopy",
    ],
)
