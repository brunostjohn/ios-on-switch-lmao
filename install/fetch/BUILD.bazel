# switch_fetch: ranged HTTPS downloads (IPSW members, release assets) that resume and are checked by SHA-256, and
# HttpFile, a Read + Seek over range requests.
#
#   bazel test //install/fetch:switch_fetch_test          against a local Range server
#   bazel test //install/fetch:apple_test                 manual: each pinned kind's device tree from Apple's URL
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

rust_library(
    name = "switch_fetch",
    srcs = glob(["src/*.rs"]),
    crate_root = "src/lib.rs",
    deps = [
        "@installer_crates//:hex",
        "@installer_crates//:reqwest",
        "@installer_crates//:serde",
        "@installer_crates//:serde_json",
        "@installer_crates//:sha2",
        "@installer_crates//:thiserror",
        "@installer_crates//:tokio",
    ],
)

rust_test(
    name = "switch_fetch_test",
    srcs = [
        "tests/http_file.rs",
        "tests/main.rs",
        "tests/release.rs",
        "tests/server.rs",
        "tests/span.rs",
    ],
    crate_root = "tests/main.rs",
    deps = [
        ":switch_fetch",
        "@installer_crates//:hex",
        "@installer_crates//:reqwest",
        "@installer_crates//:sha2",
        "@installer_crates//:tempfile",
        "@installer_crates//:tokio",
    ],
)

rust_test(
    name = "apple_test",
    srcs = ["tests/apple.rs"],
    data = ["//install/ipsw:pins.json"],
    env = {"SWITCH_PINS": "$(rlocationpath //install/ipsw:pins.json)"},
    tags = [
        "manual",
        "requires-network",
    ],
    deps = [
        ":switch_fetch",
        "@installer_crates//:hex",
        "@installer_crates//:reqwest",
        "@installer_crates//:serde_json",
        "@installer_crates//:sha2",
        "@installer_crates//:tempfile",
        "@installer_crates//:tokio",
        "@rules_rust//rust/runfiles",
    ],
)
