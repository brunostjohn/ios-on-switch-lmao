load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

_DEPS = [
    "//install/apfs_format:switch_apfs_format",
    "//install/apfs_read:switch_apfs_read",
    "//install/decmpfs:switch_decmpfs",
    "@installer_crates//:hex",
    "@installer_crates//:rayon",
    "@installer_crates//:serde",
    "@installer_crates//:serde_json",
    "@installer_crates//:sha2",
    "@installer_crates//:tempfile",
    "@installer_crates//:thiserror",
    "@installer_crates//:udif",
]

_SRCS = [
    "apfs.rs",
    "crawler.rs",
    "embedded.rs",
    "lib.rs",
    "libraries.rs",
    "metallib.rs",
]

rust_library(
    name = "switch_seed_crawl",
    srcs = _SRCS,
    crate_root = "lib.rs",
    deps = _DEPS,
)

rust_test(
    name = "switch_seed_crawl_test",
    size = "small",
    srcs = _SRCS + ["tests.rs"],
    crate_root = "lib.rs",
    data = ["//drivers/TegraGM20BMetal:plugin/TwoPlaneStandIn.h"],
    deps = _DEPS,
)
