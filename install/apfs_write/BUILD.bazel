load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

_DEPS = [
    "//install/apfs_alloc:switch_apfs_alloc",
    "//install/apfs_btree:switch_apfs_btree",
    "//install/apfs_format:switch_apfs_format",
    "//install/apfs_names:switch_apfs_names",
    "//install/apfs_read:switch_apfs_read",
    "@installer_crates//:thiserror",
    "@installer_crates//:unicode-normalization",
    "@installer_crates//:zerocopy",
]

rust_library(
    name = "switch_apfs_write",
    srcs = glob(
        ["*.rs"],
        exclude = ["tests*.rs"],
    ),
    deps = _DEPS,
)

rust_test(
    name = "switch_apfs_write_test",
    srcs = glob(["*.rs"]),
    crate_root = "lib.rs",
    deps = _DEPS,
)
