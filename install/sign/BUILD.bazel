# Ad hoc code signing, byte-equal to /usr/bin/codesign (README.md).
#
#   bazel build //install/sign:desktop                                 the six desktop builds of switch_sign_tool
#   bazel test //install/sign:darwin_test                              against codesign itself, on generated files
#   bazel test --config=ios17 //install/sign:installd_test             against the build's installd (and --config=ios27)
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//bazel/desktop:defs.bzl", "desktop_binaries")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

rust_library(
    name = "switch_sign",
    srcs = [
        "blob.rs",
        "code_directory.rs",
        "detached.rs",
        "embedded.rs",
        "entitlements.rs",
        "lib.rs",
        "macho.rs",
    ],
    crate_root = "lib.rs",
    deps = [
        "@installer_crates//:object",
        "@installer_crates//:plist",
        "@installer_crates//:sha1",
        "@installer_crates//:sha2",
        "@installer_crates//:thiserror",
    ],
)

rust_test(
    name = "switch_sign_test",
    crate = ":switch_sign",
)

rust_binary(
    name = "switch_sign_tool",
    srcs = ["main.rs"],
    deps = [
        ":switch_sign",
        "//install/plistlib:switch_plistlib",
        "@installer_crates//:plist",
    ],
)

desktop_binaries(
    name = "desktop",
    binary = ":switch_sign_tool",
)

rust_test(
    name = "darwin_test",
    srcs = [
        "tests/darwin_test.rs",
        "tests/fixture.rs",
    ],
    crate_root = "tests/darwin_test.rs",
    tags = ["requires-darwin"],
    deps = [
        ":switch_sign",
        "@installer_crates//:hex",
        "@installer_crates//:sha2",
        "@installer_crates//:tempfile",
    ],
)

py_binary(
    name = "installd_patch",
    srcs = ["installd_patch.py"],
    deps = ["//tools/install_policy:installd"],
)

genrule(
    name = "installd_patched",
    srcs = ["@ipsw//:os_installd"],
    outs = ["installd_patched.macho"],
    cmd = "$(execpath :installd_patch) $< $@",
    tools = [":installd_patch"],
)

rust_test(
    name = "installd_test",
    srcs = ["tests/installd_test.rs"],
    data = [
        ":installd_patched",
        "//drivers/SwitchInstallPolicy:installd",
        "@ipsw//:os_installd",
    ],
    env = {
        "INSTALLD": "$(rootpath @ipsw//:os_installd)",
        "INSTALLD_BUILT": "$(rootpath //drivers/SwitchInstallPolicy:installd)",
        "INSTALLD_PATCHED": "$(rootpath :installd_patched)",
    },
    deps = [
        ":switch_sign",
        "//install/plistlib:switch_plistlib",
        "@installer_crates//:hex",
        "@installer_crates//:plist",
        "@installer_crates//:sha2",
    ],
)
