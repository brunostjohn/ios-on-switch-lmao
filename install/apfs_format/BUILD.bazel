load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

rust_library(
    name = "switch_apfs_format",
    srcs = glob(
        ["*.rs"],
        exclude = ["tests.rs"],
    ),
    deps = ["@installer_crates//:zerocopy"],
)

rust_test(
    name = "switch_apfs_format_test",
    srcs = glob(["*.rs"]),
    crate_root = "lib.rs",
    deps = ["@installer_crates//:zerocopy"],
)
