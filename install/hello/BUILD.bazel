# The installer's toolchain checks, built for the six desktop platforms (bazel/desktop): Rust calling one C file, and a
# TLS fetch of the project's releases on the installer's crates.
#
#   bazel build //install/hello:all_ffi //install/hello:all_tls
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//bazel/desktop:defs.bzl", "desktop_binaries")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

cc_library(
    name = "switch_hello_c",
    srcs = ["switch_hello.c"],
)

rust_library(
    name = "switch_hello_core",
    srcs = ["core.rs"],
    link_deps = [":switch_hello_c"],
)

rust_binary(
    name = "switch_hello_ffi",
    srcs = ["ffi_main.rs"],
    deps = [":switch_hello_core"],
)

desktop_binaries(
    name = "all_ffi",
    binary = ":switch_hello_ffi",
)

rust_binary(
    name = "switch_hello",
    srcs = ["main.rs"],
    deps = [
        "@installer_crates//:crossterm",
        "@installer_crates//:ratatui",
        "@installer_crates//:reqwest",
        "@installer_crates//:serde_json",
        "@installer_crates//:tokio",
    ],
)

desktop_binaries(
    name = "all_tls",
    binary = ":switch_hello",
)
