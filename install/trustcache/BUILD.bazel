# switch_trustcache: version-2 trust cache modules as tools/trustcache/trustcache.py writes them.
#
#   bazel test //install/trustcache:all          against the build's own trust_module (oracle.py), merged_module,
#                                                cdhash_list and trust.py's bundle (merge_oracle.py)
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

rust_library(
    name = "switch_trustcache",
    srcs = [
        "lib.rs",
        "merge.rs",
        "parse.rs",
    ],
    crate_root = "lib.rs",
    deps = [
        "@installer_crates//:sha2",
        "@installer_crates//:thiserror",
    ],
)

py_binary(
    name = "oracle",
    srcs = ["oracle.py"],
    deps = ["//tools/trustcache"],
)

genrule(
    name = "oracle_cases",
    outs = ["oracle_cases.bin"],
    cmd = "$(execpath :oracle) $@",
    tools = [":oracle"],
)

rust_test(
    name = "oracle_test",
    srcs = ["oracle_test.rs"],
    data = [":oracle_cases"],
    env = {"ORACLE_CASES": "$(rootpath :oracle_cases)"},
    deps = [":switch_trustcache"],
)

py_binary(
    name = "merge_oracle",
    srcs = ["merge_oracle.py"],
    deps = [
        "//tools/package:trust",
        "//tools/trustcache",
    ],
)

genrule(
    name = "merge_oracle_cases",
    outs = ["merge_oracle_cases.bin"],
    cmd = "$(execpath :merge_oracle) $@",
    tools = [":merge_oracle"],
)

rust_test(
    name = "merge_oracle_test",
    srcs = ["merge_oracle_test.rs"],
    data = [":merge_oracle_cases"],
    env = {"MERGE_ORACLE_CASES": "$(rootpath :merge_oracle_cases)"},
    deps = [":switch_trustcache"],
)
