load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

_DEPS = [
    "@installer_crates//:crc32c",
    "@installer_crates//:ferrosys-ucd",
    "@installer_crates//:thiserror",
    "@installer_crates//:unicode-normalization",
]

rust_library(
    name = "switch_apfs_names",
    srcs = ["lib.rs"],
    deps = _DEPS,
)

rust_test(
    name = "switch_apfs_names_test",
    srcs = [
        "lib.rs",
        "tests.rs",
    ],
    crate_root = "lib.rs",
    deps = _DEPS,
)
