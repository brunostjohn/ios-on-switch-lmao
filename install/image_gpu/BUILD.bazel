# switch_image_gpu: GPU stage format 2 manifest parser and switch_apfs_write::Tree stager.
#
#   bazel test //install/image_gpu:all          unit tests + Darwin APFS fixture check
#   bazel build //install/image_gpu:desktop     fixture tool across all 6 desktop platforms
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel/desktop:defs.bzl", "desktop_binaries")
load("//bazel/lint:defs.bzl", "lint_files")
load(":assets.bzl", "gpu_assets")

package(default_visibility = ["//visibility:public"])

lint_files()

_DEPS = [
    "//install/apfs_format:switch_apfs_format",
    "//install/apfs_read:switch_apfs_read",
    "//install/apfs_write:switch_apfs_write",
    "//install/decmpfs:switch_decmpfs",
    "//install/image:switch_image",
    "@installer_crates//:flate2",
    "@installer_crates//:hex",
    "@installer_crates//:plist",
    "@installer_crates//:serde_json",
    "@installer_crates//:sha2",
    "@installer_crates//:tar",
    "@installer_crates//:thiserror",
]

_LIB_SRCS = [
    "lib.rs",
    "manifest.rs",
    "plist_merge.rs",
    "stage.rs",
    "tar_source.rs",
]

rust_library(
    name = "switch_image_gpu",
    srcs = _LIB_SRCS,
    crate_root = "lib.rs",
    deps = _DEPS,
)

rust_test(
    name = "switch_image_gpu_test",
    size = "small",
    srcs = _LIB_SRCS + [
        "tests_manifest.rs",
        "tests_source_plist.rs",
        "tests_stage.rs",
    ],
    crate_root = "lib.rs",
    deps = _DEPS + [
        "//install/apfs_alloc:switch_apfs_alloc",
        "//install/apfs_btree:switch_apfs_btree",
        "//install/apfs_names:switch_apfs_names",
        "@installer_crates//:tempfile",
        "@installer_crates//:zerocopy",
    ],
)

rust_binary(
    name = "switch_image_gpu_fixture_tool",
    srcs = ["fixture_tool.rs"],
    deps = [
        ":switch_image_gpu",
        "//install/apfs_format:switch_apfs_format",
        "//install/apfs_names:switch_apfs_names",
        "//install/apfs_read:switch_apfs_read",
        "//install/apfs_write:switch_apfs_write",
        "//install/image:switch_image",
        "@installer_crates//:clap",
    ],
)

desktop_binaries(
    name = "desktop",
    binary = ":switch_image_gpu_fixture_tool",
)

sh_test(
    name = "fixture_test",
    size = "medium",
    srcs = ["fixture_test.sh"],
    args = [
        "$(rootpath :switch_image_gpu_fixture_tool)",
        "$(rootpath //install/apfs_m1:switch_apfs_m1)",
    ],
    data = [
        ":switch_image_gpu_fixture_tool",
        "//install/apfs_m1:switch_apfs_m1",
    ],
    tags = ["requires-darwin"],
)

py_binary(
    name = "pack_gpu_asset",
    srcs = ["pack_gpu_asset.py"],
)

py_test(
    name = "pack_gpu_asset_test",
    size = "small",
    srcs = [
        "pack_gpu_asset.py",
        "pack_gpu_asset_test.py",
    ],
)

gpu_assets(
    name = "gpu_assets",
    base = "//gpu:base",
    tags = ["manual"],
)
