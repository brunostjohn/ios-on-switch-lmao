load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//bazel/lint:defs.bzl", "lint_files")

package(default_visibility = ["//visibility:public"])

lint_files()

_DEPS = [
    "//install/apfs_format:switch_apfs_format",
    "//install/apfs_names:switch_apfs_names",
    "//install/apfs_read:switch_apfs_read",
    "//install/apfs_write:switch_apfs_write",
    "//install/decmpfs:switch_decmpfs",
    "@installer_crates//:hex",
    "@installer_crates//:serde",
    "@installer_crates//:serde_json",
    "@installer_crates//:sha2",
    "@installer_crates//:thiserror",
]

rust_library(
    name = "switch_image",
    srcs = glob(
        ["*.rs"],
        exclude = ["tests*.rs"],
    ),
    deps = _DEPS,
)

rust_test(
    name = "switch_image_test",
    srcs = glob(["*.rs"]),
    crate_root = "lib.rs",
    deps = _DEPS + [
        "//install/apfs_alloc:switch_apfs_alloc",
        "@installer_crates//:flate2",
        "@installer_crates//:tempfile",
    ],
)
